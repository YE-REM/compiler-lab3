const int GLOBAL_LIMIT = 4;

int scalar_pair(int x, int y) {
    int result = x + y;
    return result;
}

float float_pair(float x, float y) {
    return x + y;
}

int vector_sum(int a[], int n) {
    int sum = 0;
    int i = 0;

    while (i < n) {
        sum = sum + a[i];
        i = i + 1;
        continue;
    }

    return sum;
}

int matrix_sum(int a[][4], int n) {
    int sum = 0;
    int i = 0;

    while (i < n) {
        sum = sum + a[i][0];
        i = i + 1;
        break;
    }

    return sum;
}

int cube_sum(int a[][2][2], int n) {
    int sum = 0;
    int i = 0;

    while (i < n) {
        sum = sum + a[i][0][0];
        i = i + 1;
    }

    return sum;
}

void empty_function() {
    return;
}

